// use prisma-8

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  username     String?
  passwordHash String
  name         String?
  phone        String?
  role         String          @default("staff")
  fcmToken     String?
  stockMoves   StockMovement[]
  notifications Notification[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@map("app_user")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  address        String?
  products       Product[]
  purchaseOrders PurchaseOrder[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Product {
  id           Int        @id @default(autoincrement())
  name         String
  sku          String     @unique
  barcode      String?    @unique
  description  String?
  price        Decimal
  costPrice    Decimal?
  reorderLevel Int        @default(10)
  safetyStock  Int        @default(5)
  imageUrl     String?
  categoryId   Int?
  supplierId   Int?
  category     Category?  @relation(fields: [categoryId], references: [id])
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])
  inventory          Inventory[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  stockMoves         StockMovement[]
  predictions        Prediction[]
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}

model Warehouse {
  id             Int             @id @default(autoincrement())
  name           String
  location       String?
  racks          Rack[]
  inventory      Inventory[]
  stockMoves     StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Rack {
  id          Int             @id @default(autoincrement())
  name        String
  warehouseId Int
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  inventory   Inventory[]
  stockMoves  StockMovement[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Inventory {
  id          Int        @id @default(autoincrement())
  productId   Int
  warehouseId Int
  rackId      Int?
  quantity    Int        @default(0)
  product     Product    @relation(fields: [productId], references: [id])
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  rack        Rack?      @relation(fields: [rackId], references: [id])
  updatedAt   temporal.updatedAtString()
}

model StockMovement {
  id              Int         @id @default(autoincrement())
  productId       Int
  warehouseId     Int
  rackId          Int?
  quantity        Int
  type            String
  referenceNumber String?
  notes           String?
  performedBy     Int?
  product         Product     @relation(fields: [productId], references: [id])
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  rack            Rack?       @relation(fields: [rackId], references: [id])
  user            User?       @relation(fields: [performedBy], references: [id])
  createdAt       TimestamptzString @default(now())
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  status      String      @default("pending")
  items       OrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Prediction {
  id          Int        @id @default(autoincrement())
  productId   Int
  predictedAt TimestamptzString @default(now())
  quantity    Int
  confidence  Decimal?
  product     Product    @relation(fields: [productId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  type      String   @default("SYSTEM_ALERT")
  title     String
  message   String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  actionUrl String?
  createdAt TimestamptzString @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Customer {
  id          Int               @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  address     String?
  salesOrders SalesOrder[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  orderNumber  String              @unique
  supplierId   Int
  warehouseId  Int
  status       String              @default("PENDING")
  subtotal     Decimal
  tax          Decimal
  total        Decimal
  notes        String?
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  items        PurchaseOrderItem[]
  createdAt    TimestamptzString   @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([orderNumber])
  @@index([status])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitPrice       Decimal
  total           Decimal
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  customerId  Int
  warehouseId Int
  status      String           @default("PENDING")
  subtotal    Decimal
  tax         Decimal
  total       Decimal
  notes       String?
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  items       SalesOrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([orderNumber])
  @@index([status])
  @@index([customerId])
  @@index([warehouseId])
  @@index([createdAt])
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal
  total        Decimal
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}