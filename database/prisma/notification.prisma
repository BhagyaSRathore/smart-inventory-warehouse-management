model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int?
  type      String    @default("SYSTEM_ALERT")
  title     String
  message   String
  severity  String    @default("INFO")
  read      Boolean   @default(false)
  actionUrl String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
