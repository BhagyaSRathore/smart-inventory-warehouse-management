// use prisma-8

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?
  passwordHash String
  name         String?
  role         String   @default("staff")
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  address      String?
  products     Product[]
  createdAt    TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Product {
  id           Int        @id @default(autoincrement())
  name         String
  sku          String     @unique
  description  String?
  price        Decimal
  categoryId   Int?
  supplierId   Int?
  category     Category?  @relation(fields: [categoryId], references: [id])
  supplier     Supplier?  @relation(fields: [supplierId], references: [id])
  inventory    Inventory[]
  orderItems   OrderItem[]
  stockMoves   StockMovement[]
  predictions  Prediction[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Warehouse {
  id          Int         @id @default(autoincrement())
  name        String
  location    String?
  racks       Rack[]
  inventory   Inventory[]
  stockMoves  StockMovement[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Rack {
  id          Int        @id @default(autoincrement())
  name        String
  warehouseId Int
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  inventory   Inventory[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Inventory {
  id          Int        @id @default(autoincrement())
  productId   Int
  warehouseId Int
  rackId      Int?
  quantity    Int        @default(0)
  product     Product    @relation(fields: [productId], references: [id])
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  rack        Rack?      @relation(fields: [rackId], references: [id])
  updatedAt   temporal.updatedAtString()
}

model StockMovement {
  id          Int         @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Int
  type        String
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  createdAt   TimestamptzString @default(now())
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  status      String      @default("pending")
  items       OrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Prediction {
  id          Int        @id @default(autoincrement())
  productId   Int
  predictedAt TimestamptzString @default(now())
  quantity    Int
  confidence  Decimal?
  product     Product    @relation(fields: [productId], references: [id])
}