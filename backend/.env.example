# Backend Environment Variables
# Copy this file to .env for local development
# For production (Railway), set these as environment variables in the dashboard

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-random-32-character-secret-key-here

# Node Environment
NODE_ENV=production

# Port (Railway will set this automatically, use 5000 for local)
PORT=5000

# Frontend URL (for CORS - set after deploying frontend to Vercel)
FRONTEND_URL=https://your-app.vercel.app

# Google Gemini API Key (Optional - for AI Assistant feature)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
